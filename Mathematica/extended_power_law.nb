            RowBox[{"density", " ", "per", " ", "ln", " ", "k"}], "*)"}], "+", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"Log", "[", "tauMin", "]"}]}], "           ", 
           RowBox[{"(*", 
            RowBox[{"tauMin", "^", "alpha"}], "*)"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Alpha]", "-", "1"}], ")"}], " ", 
            RowBox[{"Log", "[", "x", "]"}]}], "          ", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "-", 
                RowBox[{"1", "/", "tauMax"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"alpha", "-", "1"}], ")"}]}], ":", 
             RowBox[{
             "power", " ", "law", " ", "from", " ", "the", " ", "wall"}]}], 
            "*)"}], "-", 
           RowBox[{"tauMin", " ", "x"}], "                       ", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "tauMin"}], " ", 
               RowBox[{"(", 
                RowBox[{"k", "-", 
                 RowBox[{"1", "/", "tauMax"}]}], ")"}]}], "]"}], ":", 
             RowBox[{"soft", " ", "fast", " ", "cutoff"}]}], "*)"}], "-", 
           RowBox[{"LogGamma", "[", "\[Alpha]", "]"}]}], "             ", 
          RowBox[{"(*", 
           RowBox[{"1", "/", 
            RowBox[{"Gamma", "[", "alpha", "]"}]}], "*)"}], ")"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Log", "[", 
     RowBox[{"k", " ", 
      RowBox[{"pGIG", "[", 
       RowBox[{"k", ",", "alpha", ",", "kMin", ",", "kMax"}], "]"}]}], "]"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logqGIG", "[", 
      RowBox[{
       RowBox[{"k_", "?", "NumericQ"}], ",", "\[Alpha]_", ",", "kMin_", ",", 
       "kMax_"}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Log", "[", "k", "]"}], "                             ", 
       RowBox[{"(*", 
        RowBox[{"density", " ", "per", " ", "ln", " ", "k"}], "*)"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Alpha]", "-", "1"}], ")"}], " ", 
        RowBox[{"Log", "[", "k", "]"}]}], "            ", 
       RowBox[{"(*", "powerLaw", "*)"}], "-", 
       RowBox[{"k", "/", "kMax"}], "                           ", 
       RowBox[{"(*", "fastCutoff", "*)"}], "-", 
       RowBox[{"kMin", "/", "k"}], "                           ", 
       RowBox[{"(*", "slowCutoff", "*)"}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", "2", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "/", "2"}], ")"}], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"kMin", " ", "kMax"}], "]"}]}], "+", 
         RowBox[{"Log", "[", 
          RowBox[{"BesselK", "[", 
           RowBox[{"\[Alpha]", ",", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"kMin", "/", "kMax"}], "]"}]}]}], "]"}], "]"}]}], 
        ")"}]}], "   ", 
      RowBox[{"(*", 
       RowBox[{"Log", "[", "Zgig", "]"}], "*)"}], ")"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"Check", ":", 
