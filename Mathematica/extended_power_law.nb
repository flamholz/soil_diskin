         RowBox[{
         "these", " ", "equal", " ", "Log", " ", "of", " ", "the", " ", 
          "notebook", " ", "expressions", " ", "where", " ", "both", " ", 
          "can", " ", "be", " ", 
          RowBox[{
           RowBox[{"evaluated", "--"}], "--"}]}], "-"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
