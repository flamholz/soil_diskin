Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Alternative", " ", "form", " ", "where", " ", "we", " ", "start", " ", 
    "with", " ", "p", 
    RowBox[{"(", "k", ")"}], " ", "and", " ", "impose", " ", "a", " ", "soft",
     " ", "cutoff"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"assume", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "\[Element]", "Reals"}], ",", 
       RowBox[{"tauMin", ">", "0"}], ",", 
       RowBox[{"tauMax", ">", "0"}], ",", 
       RowBox[{"k", ">", "0"}], ",", " ", 
       RowBox[{"tau", ">", "0"}], ",", 
       RowBox[{"tauMax", ">", "tauMin"}], ",", " ", 
       RowBox[{"kMax", ">", "0"}], ",", " ", 
       RowBox[{"kMin", ">", "0"}], ",", 
       RowBox[{"kMax", ">", "kMin"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"p", 
     RowBox[{"(", "k", ")"}], " ", "product", " ", "of", " ", "3", " ", 
     RowBox[{"factors", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"powerLaw", "[", 
      RowBox[{"k_", ",", "\[Alpha]_"}], "]"}], ":=", 
     RowBox[{"k", "^", 
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "-", "1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fastCutoff", "[", 
      RowBox[{"k_", ",", "kMax_"}], "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "k"}], " ", "/", "kMax"}], "]"}]}], ";"}], "          ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"~", "1"}], " ", "for", " ", "k", " ", 
      RowBox[{"<<", " ", "kMax"}]}], " ", "=", " ", 
     RowBox[{"1", "/", "tauMin"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"slowCutoff", "[", 
      RowBox[{"k_", ",", "kMin_"}], "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "kMin"}], "/", "k"}], " ", "]"}]}], ";"}], "      ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"~", "1"}], " ", "for", " ", "k"}], " ", ">>", " ", 
     RowBox[{"kMin", " ", "=", " ", 
      RowBox[{"1", "/", "tauMax"}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pUnnorm", "[", 
      RowBox[{"k_", ",", "\[Alpha]_", ",", "kMin_", ",", "kMax_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"powerLaw", "[", 
       RowBox[{"k", ",", "\[Alpha]"}], "]"}], " ", 
      RowBox[{"fastCutoff", "[", 
       RowBox[{"k", ",", "kMax"}], "]"}], " ", 
      RowBox[{"slowCutoff", "[", 
       RowBox[{"k", ",", "kMin"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Normalization", ":", 
     RowBox[{
     "integrate", " ", "the", " ", "product", " ", "over", " ", "all", " ", 
      "k"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Zgig", "=", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"pUnnorm", "[", 
         RowBox[{"k", ",", "\[Alpha]", ",", "kMin", ",", "kMax"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", "assume"}]}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Zgig", " ", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kMin", "->", " ", 
        RowBox[{"1", "/", "tauMax"}]}], ",", 
       RowBox[{"kMax", "->", " ", 
        RowBox[{"1", "/", "tauMin"}]}]}], "}"}]}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"expected", ":", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"tauMin", " ", "tauMax"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "\[Alpha]"}], "/", "2"}], ")"}]}], " ", 
      RowBox[{"BesselK", "[", 
       RowBox[{"\[Alpha]", ",", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"tauMin", "/", "tauMax"}], "]"}]}]}], "]"}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", 
      RowBox[{"\[Alpha]_", ",", "kMin_", ",", "kMax_"}], "]"}], "=", "Zgig"}],
     ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Set", " ", 
      RowBox[{"(", "=", ")"}]}], ",", 
     RowBox[{"not", " ", "SetDelayed"}], ",", 
     RowBox[{
     "so", " ", "the", " ", "integral", " ", "is", " ", "done", " ", 
      "once"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pGIG", "[", 
      RowBox[{"k_", ",", "\[Alpha]_", ",", "kMin_", ",", "kMax_"}], "]"}], ":=", 
